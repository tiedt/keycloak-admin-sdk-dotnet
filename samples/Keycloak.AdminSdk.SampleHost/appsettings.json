{
  "Authentication": {
    "Authority": "https://identity.example.com/realms/platform",
    "Audience": "keycloak-admin-sample"
  },
  "Keycloak": {
    "Admin": {
      "ServerUrl": "https://identity.example.com",
      "DefaultRealm": "customers",
      "AuthenticationRealm": "master",
      "Authentication": {
        "Flow": "ClientCredentials",
        "ClientCredentials": {
          "ClientId": "sample-host-admin",
          "ClientSecret": ""
        }
      },
      "Observability": {
        "Enabled": true,
        "LogSuccessfulRequests": false,
        "EmitDiagnosticHints": true,
        "IncludeRequestPath": true,
        "PublishDiagnosticEvents": true
      }
    }
  },
  "Observability": {
    "Otlp": {
      "Enabled": false
    }
  },
  "Diagnostics": {
    "Mcp": {
      "Enabled": false
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Keycloak.AdminSdk": "Information"
    }
  },
  "AllowedHosts": "*"
}
